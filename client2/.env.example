# Timamu Client 2 Environment Variables
# Copy this file to .env and update the values for your environment

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_API_VERSION=v1

# App Configuration
VITE_APP_NAME=Timamu
VITE_APP_DESCRIPTION=Professional Mental Health Platform
VITE_APP_VERSION=2.0.0

# Environment
VITE_NODE_ENV=development

# Authentication
VITE_JWT_SECRET=your-jwt-secret-key-here
VITE_TOKEN_EXPIRY=24h

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_VIDEO_CALLS=false
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_MESSAGING=false
VITE_ENABLE_NOTIFICATIONS=true

# Third-party Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_FIREBASE_CONFIG=

# Development
VITE_DEBUG=true
VITE_MOCK_API=false

# Multi-tenant
VITE_DEFAULT_TENANT=default
VITE_TENANT_DOMAIN_MAPPING=false

# Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Appointment Configuration
VITE_DEFAULT_SESSION_DURATION=60
VITE_BOOKING_ADVANCE_DAYS=30
VITE_CANCELLATION_HOURS=24

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_PRIMARY_COLOR=#3b82f6
VITE_SECONDARY_COLOR=#64748b

# Email Configuration (for contact forms, etc.)
VITE_CONTACT_EMAIL=support@timamu.com
VITE_SUPPORT_EMAIL=help@timamu.com

# Social Media Links
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_FACEBOOK=

# Legal Links
VITE_PRIVACY_POLICY_URL=/privacy
VITE_TERMS_OF_SERVICE_URL=/terms
VITE_COOKIE_POLICY_URL=/cookies

# Monitoring
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Localization
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,es,fr

# Cache Configuration
VITE_CACHE_DURATION=300000
VITE_ENABLE_OFFLINE_MODE=false
