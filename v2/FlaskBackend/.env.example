# Database configuration
DATABASE_URL=''

# Security
SECRET_KEY=your_secure_secret_key_replace_this_in_production
JWT_SECRET_KEY=your_secure_jwt_key_replace_this_in_production

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=username
MAIL_PASSWORD=password

# OAuth2 Configuration for Google
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# Flask environment
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1

# Server port
PORT=5000