generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  password          String?
  firstName         String
  lastName          String
  role              Role              @default(PATIENT)
  isActive          Boolean           @default(true)
  isVerified        Boolean           @default(false)
  avatar            String?
  phone             String?
  dateOfBirth       DateTime?
  gender            Gender?
  googleId          String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lastLoginAt       DateTime?
  adminProfile      AdminProfile?
  auditLogs         AuditLog[]
  uploadedFiles     File[]
  receivedMessages  Message[]         @relation("MessageReceiver")
  sentMessages      Message[]         @relation("MessageSender")
  patientProfile    PatientProfile?
  givenRatings      Rating[]          @relation("RatingGiver")
  receivedRatings   Rating[]          @relation("RatingReceiver")
  refreshTokens     RefreshToken[]
  patientSessions   Session[]         @relation("PatientSessions")
  therapistSessions Session[]         @relation("TherapistSessions")
  therapistProfile  TherapistProfile?

  @@map("users")
}

model PatientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  medicalHistory    String?
  emergencyContact  String?
  preferredLanguage String   @default("en")
  timezone          String   @default("UTC")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

model TherapistProfile {
  id               String        @id @default(uuid())
  userId           String        @unique
  licenseNumber    String        @unique
  specializations  String[]
  experience       Int
  education        String?
  biography        String?
  isApproved       Boolean       @default(false)
  approvedAt       DateTime?
  timezone         String        @default("UTC")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  acceptsEmergency Boolean       @default(false)
  availability     Json?
  languages        String[]
  sessionNotes     SessionNote[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("therapist_profiles")
}

model AdminProfile {
  id          String     @id @default(uuid())
  userId      String     @unique
  permissions String[]
  level       AdminLevel @default(MODERATOR)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model Session {
  id             String        @id @default(uuid())
  patientId      String
  therapistId    String
  scheduledAt    DateTime
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?
  status         SessionStatus @default(SCHEDULED)
  sessionType    SessionType   @default(VIDEO)
  notes          String?
  recordingUrl   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  emergencyNotes String?
  isEmergency    Boolean       @default(false)
  title          String?
  files          File[]
  messages       Message[]
  rating         Rating?
  sessionNotes   SessionNote[]
  patient        User          @relation("PatientSessions", fields: [patientId], references: [id])
  therapist      User          @relation("TherapistSessions", fields: [therapistId], references: [id])

  @@map("sessions")
}

model SessionNote {
  id                  String           @id @default(uuid())
  sessionId           String
  therapistId         String
  content             String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  isSharedWithPatient Boolean          @default(false)
  session             Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  therapist           TherapistProfile @relation(fields: [therapistId], references: [id])

  @@map("session_notes")
}

model Message {
  id          String      @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  messageType MessageType @default(TEXT)
  sessionId   String?
  isRead      Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())
  receiver    User        @relation("MessageReceiver", fields: [receiverId], references: [id])
  sender      User        @relation("MessageSender", fields: [senderId], references: [id])
  session     Session?    @relation(fields: [sessionId], references: [id])

  @@map("messages")
}

model Rating {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  giverId     String
  receiverId  String
  rating      Int
  review      String?
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  giver       User     @relation("RatingGiver", fields: [giverId], references: [id])
  receiver    User     @relation("RatingReceiver", fields: [receiverId], references: [id])
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model File {
  id           String       @id @default(uuid())
  originalName String
  fileName     String       @unique
  filePath     String
  mimeType     String
  size         Int
  uploaderId   String
  sessionId    String?
  isPublic     Boolean      @default(false)
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  category     FileCategory @default(OTHER)
  description  String?
  session      Session?     @relation(fields: [sessionId], references: [id])
  uploader     User         @relation(fields: [uploaderId], references: [id])

  @@map("files")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  status     String
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AdminLevel {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionType {
  VIDEO
  AUDIO_ONLY
  CHAT_ONLY
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM
}

enum FileCategory {
  RESOURCE
  HOMEWORK
  REPORT
  OTHER
}
