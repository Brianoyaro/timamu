// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model with role-based access
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String?  // Nullable for OAuth users
  firstName     String
  lastName      String
  role          Role     @default(PATIENT)
  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false)
  avatar        String?
  phone         String?
  dateOfBirth   DateTime?
  gender        Gender?
  
  // OAuth fields
  googleId      String?  @unique
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?
  
  // Relations
  patientProfile    PatientProfile?
  therapistProfile  TherapistProfile?
  adminProfile      AdminProfile?
  
  // Sessions and messages
  patientSessions   Session[] @relation("PatientSessions")
  therapistSessions Session[] @relation("TherapistSessions")
  sentMessages      Message[] @relation("MessageSender")
  receivedMessages  Message[] @relation("MessageReceiver")
  
  // Files and documents
  uploadedFiles     File[]
  
  // Audit logs
  auditLogs         AuditLog[]
  
  // Refresh tokens
  refreshTokens     RefreshToken[]
  
  @@map("users")
}

// Patient-specific profile
model PatientProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Medical information
  medicalHistory  String?
  emergencyContact String?
  insuranceInfo   String?
  
  // Preferences
  preferredLanguage String @default("en")
  timezone         String  @default("UTC")
  
  // Therapist relationships (many-to-many)
  therapistAssignments PatientTherapistAssignment[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("patient_profiles")
}

// Therapist-specific profile
model TherapistProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Professional information
  licenseNumber     String    @unique
  specializations   String[]  // Array of specialization tags
  experience        Int       // Years of experience
  education         String?
  biography         String?
  hourlyRate        Decimal?  @db.Decimal(10, 2)
  
  // Status
  isApproved        Boolean   @default(false)
  approvedAt        DateTime?
  approvedBy        String?
  
  // Availability
  workingHours      Json?     // Flexible JSON structure for availability
  timezone          String    @default("UTC")
  
  // Patient relationships (many-to-many)
  patientAssignments PatientTherapistAssignment[]
  capabilities       TherapistSpecializationCapability[]
  
  // Session notes
  sessionNotes       SessionNote[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("therapist_profiles")
}

// Admin-specific profile
model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  permissions String[] // Array of admin permissions
  level       AdminLevel @default(MODERATOR)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("admin_profiles")
}

// Session model for therapy sessions
model Session {
  id              String        @id @default(uuid())
  
  // Assignment context (optional during migration)
  assignmentId    String?
  assignment      PatientTherapistAssignment? @relation(fields: [assignmentId], references: [id])
  
  // Participants (derived from assignment)
  patientId       String
  patient         User          @relation("PatientSessions", fields: [patientId], references: [id])
  therapistId     String
  therapist       User          @relation("TherapistSessions", fields: [therapistId], references: [id])
  
  // Session details
  scheduledAt     DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int?          // Duration in minutes
  status          SessionStatus @default(SCHEDULED)
  
  // Session metadata
  sessionType     SessionType   @default(VIDEO)
  notes           String?
  recordingUrl    String?       // Encrypted recording URL
  
  // Billing
  cost            Decimal?      @db.Decimal(10, 2)
  isPaid          Boolean       @default(false)
  
  // Relations
  messages        Message[]
  files           File[]
  sessionNotes    SessionNote[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@map("sessions")
}

// Session notes by therapists
model SessionNote {
  id            String           @id @default(uuid())
  sessionId     String
  session       Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  therapistId   String
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id])
  
  content       String
  isPrivate     Boolean          @default(true) // Private notes only for therapist
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  @@map("session_notes")
}

// Real-time messaging
model Message {
  id          String      @id @default(uuid())
  
  // Participants
  senderId    String
  sender      User        @relation("MessageSender", fields: [senderId], references: [id])
  receiverId  String
  receiver    User        @relation("MessageReceiver", fields: [receiverId], references: [id])
  
  // Message content
  content     String
  messageType MessageType @default(TEXT)
  isEncrypted Boolean     @default(true)
  
  // Session context (optional)
  sessionId   String?
  session     Session?    @relation(fields: [sessionId], references: [id])
  
  // Status
  isRead      Boolean     @default(false)
  readAt      DateTime?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@map("messages")
}

// File uploads and documents
model File {
  id            String   @id @default(uuid())
  
  // File metadata
  originalName  String
  fileName      String   @unique
  filePath      String
  mimeType      String
  size          Int      // File size in bytes
  
  // Security
  isEncrypted   Boolean  @default(true)
  encryptionKey String?  // Encrypted with app secret
  
  // Relations
  uploaderId    String
  uploader      User     @relation(fields: [uploaderId], references: [id])
  sessionId     String?
  session       Session? @relation(fields: [sessionId], references: [id])
  
  // Access control
  isPublic      Boolean  @default(false)
  expiresAt     DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("files")
}

// Refresh tokens for JWT authentication
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("refresh_tokens")
}

// Audit logging for security and compliance
model AuditLog {
  id          String     @id @default(uuid())
  
  // User context
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  userEmail   String?    // Store email in case user is deleted
  
  // Action details
  action      String     // LOGIN, LOGOUT, CREATE_SESSION, etc.
  resource    String?    // What was acted upon
  resourceId  String?    // ID of the resource
  
  // Request details
  ipAddress   String?
  userAgent   String?
  method      String?    // HTTP method
  endpoint    String?    // API endpoint
  
  // Result
  status      String     // SUCCESS, FAILURE, ERROR
  details     Json?      // Additional context
  
  createdAt   DateTime   @default(now())
  
  @@map("audit_logs")
}

// Normalized therapy specialization catalog
model TherapySpecialization {
  id                    String  @id @default(uuid())
  code                  String  @unique // "FAM001", "SUI001", "ADD001"
  name                  String  // "Family Therapy", "Suicide Prevention"
  category              String  // "specialized", "general", "emergency"
  description           String?
  requiresSpecialCert   Boolean @default(false)
  emergencyAccess       Boolean @default(false) // Can be accessed without assignment
  maxConcurrentPatients Int?    // Per therapist limit
  
  // Relations
  assignments           PatientTherapistAssignment[]
  therapistCapabilities TherapistSpecializationCapability[]
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("therapy_specializations")
}

// Therapist capabilities - what they can provide
model TherapistSpecializationCapability {
  id               String                @id @default(uuid())
  therapistId      String
  therapist        TherapistProfile      @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  specializationId String
  specialization   TherapySpecialization @relation(fields: [specializationId], references: [id])
  
  // Capability details
  certificationLevel String? // "certified", "expert", "trainee"
  yearsExperience   Int?
  isActive          Boolean @default(true)
  hourlyRate        Decimal? @db.Decimal(10, 2) // Can override base rate
  maxPatients       Int?     // Override specialization limit
  
  // Verification
  certifiedAt       DateTime?
  certifiedBy       String?  // Admin who verified
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([therapistId, specializationId])
  @@map("therapist_specialization_capabilities")
}

// Assignment types for flexible relationships
model AssignmentType {
  id          String  @id @default(uuid())
  code        String  @unique // "primary", "specialist", "emergency", "consultation"
  name        String  // "Primary Care", "Specialist Care"
  description String?
  priority    Int     @default(1) // Higher number = higher priority
  
  // Business rules
  allowsConcurrent     Boolean @default(false) // Can have multiple of this type
  requiresApproval     Boolean @default(false)
  defaultMaxSessions   Int?
  defaultDurationDays  Int?
  
  // Relations
  assignments          PatientTherapistAssignment[]
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@map("assignment_types")
}

// Flexible patient-therapist relationships
model PatientTherapistAssignment {
  id                  String                @id @default(uuid())
  
  // Core relationship
  patientId           String
  patient             PatientProfile        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapistId         String
  therapist           TherapistProfile      @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  
  // Assignment metadata
  assignmentTypeId    String
  assignmentType      AssignmentType        @relation(fields: [assignmentTypeId], references: [id])
  specializationId    String
  specialization      TherapySpecialization @relation(fields: [specializationId], references: [id])
  
  // Status and lifecycle
  status              AssignmentStatus      @default(PENDING)
  startDate           DateTime              @default(now())
  endDate             DateTime?
  
  // Session management
  maxSessions         Int?
  sessionsCompleted   Int                   @default(0)
  
  // Financial
  agreedRate          Decimal?              @db.Decimal(10, 2)
  
  // Approval workflow
  requestedBy         String                // User ID who requested
  approvedBy          String?               // Admin/therapist who approved
  approvedAt          DateTime?
  rejectionReason     String?
  
  // Metadata
  referralSource      String?               // "self", "primary_therapist", "emergency"
  notes               String?
  
  // Relations
  sessions            Session[]
  
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  
  @@unique([patientId, therapistId, specializationId, status], name: "unique_active_assignment")
  @@map("patient_therapist_assignments")
}

// Enums
enum Role {
  PATIENT
  THERAPIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AdminLevel {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionType {
  VIDEO
  AUDIO_ONLY
  CHAT_ONLY
}

enum MessageType {
  TEXT
  FILE
  IMAGE
  SYSTEM
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED
  EXPIRED
}
