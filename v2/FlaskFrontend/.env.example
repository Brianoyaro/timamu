# Flask API URL (adjust if needed)
VITE_API_URL=http://localhost:5000/api
# Socket URL (same as the Flask backend URL without the /api path)
VITE_SOCKET_URL=http://localhost:5000
# MediaSoup server URL for video calling
VITE_MEDIASOUP_URL=http://localhost:3001

# Cloudinary Configuration
# Get these values from your Cloudinary Dashboard: https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name-here
VITE_CLOUDINARY_API_KEY=your-api-key-here
VITE_CLOUDINARY_API_SECRET=your-api-secret-here
VITE_CLOUDINARY_UPLOAD_PRESET=timamu-uploads

# Other Environment Variables
VITE_APP_NAME=Timamu
VITE_APP_ENV=development